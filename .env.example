# Copy this file to .env and provide the private values locally.
# Never commit .env.

LLM_API_BASE=https://your-openai-compatible-endpoint.example/api
LLM_API_KEY=replace-with-your-api-key
LLM_API_MODEL=openai/kimi-k2.6
LLM_API_MODEL_ALIASES=kimi-k2.6
LLM_SSL_VERIFY=false
LLM_CONNECT_TIMEOUT=5
LLM_READ_TIMEOUT=120
LLM_CIRCUIT_BREAKER_SECONDS=300
